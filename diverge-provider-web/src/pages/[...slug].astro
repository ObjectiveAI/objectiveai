---
import { render } from "astro:content";

import { SpecPage } from "../components/SpecPage";
import Layout from "../layouts/Layout.astro";
import { REVISION } from "../revision";
import { flattened, navigation, type Located } from "../spec";

export async function getStaticPaths() {
  const all = await flattened();
  const nodes = await navigation();
  return all.map((located, position) => ({
    params: { slug: located.section.segments.join("/") },
    props: {
      located,
      nodes,
      previous: position > 0 ? all[position - 1].section : null,
      next: position + 1 < all.length ? all[position + 1].section : null,
    },
  }));
}

interface Props {
  located: Located;
  nodes: Awaited<ReturnType<typeof navigation>>;
  previous: Located["section"] | null;
  next: Located["section"] | null;
}

const { located, nodes, previous, next } = Astro.props;
const { section, trail, children } = located;
const { Content } = await render(section.entry);

const crumbs = [
  { url: "/", label: `Specification ${REVISION}` },
  ...trail.map((ancestor) => ({
    url: ancestor.url,
    label: ancestor.entry.data.title,
  })),
];
---

<Layout
  title={section.entry.data.title}
  description={section.entry.data.summary}
  path={section.url}
  markdown={section.markdownUrl}
>
  <SpecPage
    title={section.entry.data.title}
    summary={section.entry.data.summary}
    markdownUrl={section.markdownUrl}
    crumbs={crumbs}
    nodes={nodes}
    current={section.url}
    previous={previous
      ? { url: previous.url, title: previous.entry.data.title }
      : { url: "/", title: "Overview" }}
    next={next && { url: next.url, title: next.entry.data.title }}
    draft={section.entry.data.draft}
    subsections={children.map((child) => ({
      url: child.url,
      title: child.entry.data.title,
      summary: child.entry.data.summary,
    }))}
  >
    <Content />
  </SpecPage>
</Layout>
