---
import { render } from "astro:content";

import { SpecPage } from "../../components/SpecPage";
import Layout from "../../layouts/Layout.astro";
import { REVISION } from "../../revision";
import { layers, ordered, type Layer, type Section } from "../../spec";

export async function getStaticPaths() {
  const all = await ordered();
  const tree = await layers();
  return all.map((section, position) => ({
    params: {
      revision: REVISION,
      slug:
        section.section === null
          ? section.layer
          : `${section.layer}/${section.section}`,
    },
    props: {
      section,
      tree,
      previous: position > 0 ? all[position - 1] : null,
      next: position + 1 < all.length ? all[position + 1] : null,
    },
  }));
}

interface Props {
  section: Section;
  tree: Layer[];
  previous: Section | null;
  next: Section | null;
}

const { section, tree, previous, next } = Astro.props;
const { Content } = await render(section.entry);

const crumbs = [
  { url: "/", label: `Specification ${REVISION}` },
];
if (section.section !== null) {
  const layer = tree.find((candidate) => candidate.index.layer === section.layer);
  if (layer) {
    crumbs.push({ url: layer.index.url, label: layer.index.entry.data.title });
  }
}

const navLayers = tree.map((layer) => ({
  index: { url: layer.index.url, title: layer.index.entry.data.title },
  sections: layer.sections.map((child) => ({
    url: child.url,
    title: child.entry.data.title,
  })),
}));
---

<Layout
  title={section.entry.data.title}
  description={section.entry.data.summary}
  path={section.url}
  markdown={section.markdownUrl}
>
  <SpecPage
    title={section.entry.data.title}
    summary={section.entry.data.summary}
    markdownUrl={section.markdownUrl}
    crumbs={crumbs}
    layers={navLayers}
    current={section.url}
    previous={previous && {
      url: previous.url,
      title: previous.entry.data.title,
    }}
    next={next && { url: next.url, title: next.entry.data.title }}
    draft={section.entry.data.draft}
  >
    <Content />
  </SpecPage>
</Layout>
