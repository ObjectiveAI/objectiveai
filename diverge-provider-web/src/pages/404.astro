---
import Layout from "../layouts/Layout.astro";
import { REVISION } from "../revision";
---

<Layout
  title="Not found"
  description="There is nothing at this URL. The specification's table of contents lists every page that exists."
  path="/404/"
>
  <div class="page">
    <main>
      <article>
        <h1>Not found</h1>
        <p>
          There is nothing at this URL. Start from the
          <a href="/">table of contents</a> — and if a link
          brought you here, the page may belong to a different revision
          than {REVISION}.
        </p>
      </article>
    </main>
  </div>
</Layout>
