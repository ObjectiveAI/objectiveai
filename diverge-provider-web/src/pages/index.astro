---
import { SpecNav } from "../components/SpecNav";
import Layout from "../layouts/Layout.astro";
import { REVISION } from "../revision";
import { layers } from "../spec";

const tree = await layers();
const navLayers = tree.map((layer) => ({
  index: { url: layer.index.url, title: layer.index.entry.data.title },
  sections: layer.sections.map((child) => ({
    url: child.url,
    title: child.entry.data.title,
  })),
}));
---

<Layout
  title={`Diverge Provider Protocol — Specification ${REVISION}`}
  description="The specification of the Diverge Provider Protocol: the wire protocol between callers and providers for running agentic loops, MCP plugins, and laboratories, and for managing volumes and images."
  path="/"
>
  <div class="page">
    <div class="columns">
      <aside>
        <SpecNav layers={navLayers} current="/" />
      </aside>
      <main>
        <article>
          <h1>Diverge Provider Protocol — Specification {REVISION}</h1>
          <p class="summary">
            The wire protocol between callers and providers: running agentic
            loops, MCP plugins, and laboratories; managing volumes; checking
            images. One WebSocket connection, framed and multiplexed, with a
            handshake in front.
          </p>
          <p>
            The protocol's normative definition is the
            <a href="https://docs.rs/diverge-provider-sdk"
              ><code>diverge-provider-sdk</code></a
            > Rust crate — its types define the messages, and where this site's
            prose and the crate disagree, the crate is correct. The revision
            number is that crate's version.
          </p>
          <p>
            The whole specification is also available as
            <a href={`/${REVISION}/full/`}>a single page</a>, as
            <a href="/llms-full.txt">one plain-text file</a>, and section by
            section as raw Markdown — every page links its own
            <code>.md</code> twin, and <a href="/llms.txt">/llms.txt</a>
            indexes them all. The crate and this site live in
            <a href="https://github.com/ObjectiveAI/objectiveai"
              >one repository</a
            >.
          </p>
        </article>
      </main>
    </div>
  </div>
</Layout>
