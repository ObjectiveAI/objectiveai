---
import { render } from "astro:content";

import { Adjacent } from "../components/Adjacent";
import { Breadcrumbs } from "../components/Breadcrumbs";
import { MarkdownLink } from "../components/MarkdownLink";
import { SpecNav } from "../components/SpecNav";
import Layout from "../layouts/Layout.astro";
import { REVISION } from "../revision";
import { navigation, ordered, overview } from "../spec";

const navLayers = await navigation();
const all = await ordered();
const next =
  all.length > 0
    ? { url: all[0].url, title: all[0].entry.data.title }
    : null;

const page = await overview();
const { Content } = await render(page.entry);
---

<Layout
  title={`Diverge Provider Protocol — Specification ${REVISION}`}
  description={page.entry.data.summary}
  path={page.url}
  markdown={page.markdownUrl}
>
  <div class="page">
    <Breadcrumbs
      crumbs={[{ url: "/", label: `Specification ${REVISION}` }]}
      current={page.entry.data.title}
    />
    <div class="columns">
      <aside>
        <SpecNav layers={navLayers} current={page.url} />
      </aside>
      <main>
        <article>
          <h1>Diverge Provider Protocol — Specification {REVISION}</h1>
          <p class="summary">{page.entry.data.summary}</p>
          <Content />
          <MarkdownLink url={page.markdownUrl} />
        </article>
        <Adjacent previous={null} next={next} />
      </main>
    </div>
  </div>
</Layout>
