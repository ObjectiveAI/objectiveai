---
import Layout from "../layouts/Layout.astro";
import { latest, versions } from "../spec";

// The root is not a page of any revision: it sends the reader to the
// latest, and lists every revision for a reader whose client did not
// follow. Every path of the specification carries its revision first;
// a path without one is nothing, and the 404 says so.
const target = `/${latest()}/`;
const all = await versions();
---

<Layout
  title="Diverge Provider Protocol"
  description={`The Diverge Provider Protocol specification, by revision. The latest is ${latest()}.`}
  path={target}
  refresh={target}
>
  <div class="page">
    <main>
      <article>
        <h1>Diverge Provider Protocol</h1>
        <p>
          The latest revision of the specification is
          <a href={target}>{latest()}</a>. Every revision the site holds:
        </p>
        <ul>
          {all.map((version) => (
            <li>
              <a href={`/${version}/`}>Specification {version}</a>
              {version === latest() && " (latest)"}
            </li>
          ))}
        </ul>
      </article>
    </main>
  </div>
</Layout>
