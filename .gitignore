# Ignore markdown files at repository root (Claude working files)
/*.md
!README.md
!CLAUDE.md
!SDK.md
!PLUGINS.md
# Visible-but-NEVER-committed working doc: the negation makes git
# report it as untracked (so editors show it) — do NOT stage it.
!FINDINGS.md

# ignore temp
temp/
tmp/

# audit files (local only)
audit/

# test harness (local only)
objectiveai-viewer/__test_harness__/

# unrelated experiments
objectiveai-claude-agent-sdk-runner-py/

# ignore build tools (repo-root only — .objectiveai/bin is committed)
/bin/
.crates.toml
.crates2.json

# ignore logs
.logs/

# Screenshots (Claude working files)
/*.png

# Playwright MCP
.playwright-mcp/

# Next.js build output (root level)
.next/

# ignore embedded binaries
**/embed/
target-*/

# rustpython wasm blob cache (built by objectiveai-daemon/build.rs)
objectiveai-daemon/.cache/

# local staging dir for json schemas; never committed (the crate's
# cargo publish does not need it staged)
objectiveai-sdk-rs/schemas/

.objectiveai/