# The python agent image: the loop, a musl binary, on the official
# Python image — the system interpreter the agent's source runs on,
# and the pip its requirements install with.
#
# The container proxy is NOT in this image. The host injects it at
# runtime, and it may not be up at all until a request comes — which
# is why the loop touches nothing of the proxy's until `POST /run`
# arrives: no database, no MCP session before then. Registration
# touches only the disk and pip.
#
# Build from the WORKSPACE ROOT — the crates ride path dependencies:
#
#     podman build -f diverge-agentic-loop-python/Containerfile .
#
# The builder is openrouter's Alpine rust image: the musl toolchain is
# its default target, and a static musl binary runs on the Debian
# below without asking it for anything. Digests pinned from Docker
# Hub — the builder's on 2026-08-26, the runner's on 2026-09-09; bump
# deliberately.

# rust:1.98.0-alpine3.24.
FROM docker.io/library/rust:1.98.0-alpine3.24@sha256:a10e64dd139b7387337c7fbe8aca31b959b57b2fd4c8ae20a02cf1d6ea424dce AS build

# `ring` (rustls' crypto) compiles C; build-base is the whole musl C
# toolchain.
RUN apk add --no-cache build-base

WORKDIR /build

# Only the crates this image needs, in their workspace layout — the
# workspace manifest itself is NOT copied, so the crate builds as its
# own root and the absent sibling members are never asked for. The
# workspace lockfile rides into the crate so the resolved versions
# hold; cargo prunes the entries the crate does not use, which is why
# the build does not pass --locked.
COPY diverge-provider-sdk-rs diverge-provider-sdk-rs
COPY diverge-container-proxy-sdk diverge-container-proxy-sdk
COPY diverge-agentic-loop-python diverge-agentic-loop-python
COPY Cargo.lock diverge-agentic-loop-python/Cargo.lock

RUN cargo build --release \
    --manifest-path diverge-agentic-loop-python/Cargo.toml

# python:3.13-slim-bookworm, by digest: CPython 3.13 with pip, on
# Debian bookworm, and nothing else. `python3` on the path is this
# interpreter, and it is the one the harness runs and pip installs
# into — the system python, by ruling; no venv is made.
FROM docker.io/library/python:3.13-slim-bookworm@sha256:ed86c82274b3c69b52fb5820f358f0bd7df0b603332063cb5c6e32bd220c3e6e

# Where registration writes the harness and the agent's source; made
# here so the write needs no directory of its own to fail on.
RUN mkdir -p /var/lib/diverge-python

# The script runs from here, and whatever it writes stays for the
# container's life.
WORKDIR /root

COPY --from=build \
    /build/diverge-agentic-loop-python/target/release/diverge-agentic-loop-python \
    /usr/local/bin/diverge-agentic-loop-python

# The loop's own server, on the loopback: 8080, or whatever `PORT`
# names. Nothing is exposed — the proxy the host injects is the only
# thing that dials it, and it is beside it.

ENTRYPOINT ["/usr/local/bin/diverge-agentic-loop-python"]
