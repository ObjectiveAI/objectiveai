{
  "title": "laboratories.executions.response.unary.Evaluation",
  "description": "A single evaluation agent completion within a laboratory execution (non-streaming).",
  "type": "object",
  "properties": {
    "agent_index": {
      "description": "Agent index (0-based).",
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "continuation": {
      "description": "Continuation state for multi-turn conversations.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "error": {
      "description": "Error details if this completion failed.",
      "anyOf": [
        {
          "$ref": "error.ResponseError"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "index": {
      "description": "Evaluation index (0-based).",
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "agent.completions.response.unary.Message"
      }
    },
    "messages_queued": {
      "description": "`true` when the MCP proxy holds queued messages that were not\ndelivered to the agent via a tool response on this turn. See\n[`super::streaming::AgentCompletionChunk::messages_queued`].",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "object": {
      "description": "The object type (always \"agent.completion\").",
      "$ref": "agent.completions.response.unary.Object"
    },
    "output": {
      "anyOf": [
        {
          "$ref": "functions.expression.InputValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "upstream": {
      "description": "Upstream provider",
      "$ref": "agent.Upstream"
    },
    "usage": {
      "$ref": "agent.completions.response.Usage"
    }
  }
}
