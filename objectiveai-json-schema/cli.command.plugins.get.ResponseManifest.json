{
  "title": "cli.command.plugins.get.ResponseManifest",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "exec": {
      "description": "Per-OS exec argv for the plugin's cli side, run with CWD =\n`<plugin dir>/cli/` — the same shape tools use. Required (an\nempty exec is a viewer-only plugin, which still round-trips as\nan empty per-OS object).",
      "$ref": "cli.command.tools.get.Exec"
    },
    "mcp_servers": {
      "type": "array",
      "items": {
        "$ref": "cli.command.plugins.get.ResponseMcpServer"
      }
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "viewer_routes": {
      "type": "array",
      "items": {
        "$ref": "cli.command.plugins.get.ResponseViewerRoute"
      }
    },
    "viewer_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    }
  }
}
