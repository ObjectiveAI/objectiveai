{
  "title": "mcp.tool.CallToolResult",
  "description": "The server's response to a `tools/call` request.",
  "type": "object",
  "properties": {
    "_meta": {
      "description": "Extension metadata.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "content": {
      "description": "Content blocks representing the result of the tool call.",
      "type": "array",
      "items": {
        "$ref": "mcp.tool.ContentBlock"
      },
      "default": []
    },
    "isError": {
      "description": "Whether the tool call ended in an error.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "structuredContent": {
      "description": "Structured tool output matching the tool's `outputSchema`.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    }
  }
}
