{
  "title": "http.viewer.LaboratoryExecutionCreateParams",
  "description": "Parameters for creating a laboratory execution.",
  "type": "object",
  "properties": {
    "builder_agents": {
      "description": "Builder agents — at least one required.",
      "type": "array",
      "items": {
        "$ref": "agent.InlineAgentBaseWithFallbacksOrRemoteCommitOptional"
      }
    },
    "builder_continuation": {
      "description": "Continuation from a previous builder completion, as a base64-encoded string.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "builder_messages": {
      "description": "Messages for builder agents.",
      "type": "array",
      "items": {
        "$ref": "agent.completions.message.Message"
      }
    },
    "docker_image": {
      "description": "Docker image to use for builder containers.",
      "type": "string"
    },
    "evaluation_agent": {
      "description": "Evaluation agent for evaluating builder outputs. If not provided,\nno evaluation is performed.",
      "anyOf": [
        {
          "$ref": "agent.InlineAgentBaseWithFallbacksOrRemoteCommitOptional"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "evaluation_continuation": {
      "description": "Continuation from a previous evaluation completion, as a base64-encoded string.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "evaluation_messages": {
      "description": "Messages for the evaluation agent.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "agent.completions.message.Message"
          }
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "evaluation_output_schema": {
      "description": "Output schema for evaluation.",
      "anyOf": [
        {
          "$ref": "functions.expression.InputSchema"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "id": {
      "type": "string"
    },
    "max_evaluation_retries": {
      "description": "Maximum number of evaluation retries if validation fails.\nDefaults to 3 if not specified.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "persist": {
      "description": "Whether to keep containers after execution. Defaults to false.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "agent.completions.request.Provider"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "stream": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    }
  }
}
