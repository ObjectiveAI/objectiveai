      "$ref": "agent.InlineAgentBaseWithFallbacksOrRemoteCommitOptional"
    },
    "continuation": {
      "description": "Continuation from a previous completion, as a base64-encoded string.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "laboratories": {
      "description": "Laboratories (client-side MCP servers) attached across all agents,\nincluding fallbacks.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "laboratories.Laboratory"
          }
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "messages": {
      "description": "The conversation messages.",
      "type": "array",
      "items": {
        "$ref": "agent.completions.message.Message"
      }
    },
    "provider": {
