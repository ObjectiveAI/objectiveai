{
  "title": "cli.agents_instances_listener.AgentInstanceEvent",
  "description": "One event on the `/agents/instances/{*aih}` stream. The\nconversation events carry ONE mirrored part each, addressed by\ntheir block's boundary fields (exactly the fields `ResponseItem`\nkeeps at block level) plus the row's DB identity — `row_index` /\n`row_sub_index` are `objectiveai.messages`' values, an OPAQUE\nreplace-at + ordering key: a re-sent identity replaces the prior\npart, both within the snapshot/live seam and across streaming\nupdates of one part. Single-row blocks (`vote` / `error`) ship\ncomplete.\n\nThe DB snapshot replays first (in `objectiveai.messages.\"index\"`\norder), one `Live` marks the snapshot complete, then live events\nfollow as the conversation occurs. `Agent` events (the status\nrecord) are structurally independent and can arrive at any time.\n\nExtensibility contract: future variants WILL be added — consumers\nmust skip events they cannot parse.",
  "anyOf": [
    {
      "title": "RequestMessageUserPart",
      "description": "One part of a `RequestMessageUser` block. `row_index` = message\nindex, `row_sub_index` = part index.",
      "type": "object",
      "properties": {
        "agent_instance_hierarchy": {
          "type": "string"
        },
        "part": {
          "$ref": "cli.agents_instances_listener.RequestMessageUserPart"
        },
        "response_id": {
          "type": "string"
        },
        "row_index": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "row_sub_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ],
          "omitempty": true
        },
        "type": {
          "type": "string",
          "enum": [
            "request_message_user_part"
          ]
        }
      }
    },
    {
