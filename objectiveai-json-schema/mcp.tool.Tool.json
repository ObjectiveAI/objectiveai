{
  "title": "mcp.tool.Tool",
  "description": "A tool that an MCP server exposes for invocation.",
  "type": "object",
  "properties": {
    "_meta": {
      "description": "Extension metadata.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "annotations": {
      "description": "Additional tool metadata.",
      "anyOf": [
        {
          "$ref": "mcp.tool.ToolAnnotations"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "description": {
      "description": "A human-readable description of the tool.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "execution": {
      "description": "Execution-related properties.",
      "anyOf": [
        {
          "$ref": "mcp.tool.ToolExecution"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "icons": {
      "description": "Icons for the tool.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "mcp.shared.Icon"
          }
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "inputSchema": {
      "description": "JSON Schema defining the expected input parameters.\nMust have `type: \"object\"` at the root level.",
      "$ref": "mcp.tool.ToolSchemaObject"
    },
    "name": {
      "description": "The programmatic name of the tool.",
      "type": "string"
    },
    "outputSchema": {
      "description": "JSON Schema defining the structure of the tool's output\n(returned in `structuredContent`).",
      "anyOf": [
        {
          "$ref": "mcp.tool.ToolSchemaObject"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "title": {
      "description": "A human-readable display name.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    }
  }
}
