{
  "title": "cli.command.agents.logs.read.subscribe.Request",
  "type": "object",
  "properties": {
    "after_id": {
      "description": "Skip rows with `logs.messages.\"index\" <= after_id`.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "jq": {
      "description": "jq filter applied to the JSON output.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kinds": {
      "description": "Filter to rows whose `MessageTable` falls in the selected\nbucket(s). `None` on the wire = no filter (all kinds).",
      "anyOf": [
        {
          "$ref": "cli.command.agents.logs.read.subscribe.KindFilter"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "limit": {
      "description": "Cap on rows scanned per target.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "path_type": {
      "$ref": "cli.command.agents.logs.read.subscribe.Path"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "cli.command.agents.logs.read.all.Target"
      }
    }
  }
}
