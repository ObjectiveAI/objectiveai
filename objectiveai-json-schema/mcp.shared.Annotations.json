      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "mcp.shared.Role"
          }
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "lastModified": {
      "description": "ISO 8601 timestamp for the most recent modification.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    },
    "priority": {
      "description": "Importance hint, from 0 (least) to 1 (most).",
      "anyOf": [
        {
          "type": "number",
          "minimum": -3.4028235e+38,
          "maximum": 3.4028235e+38
        },
        {
          "type": "null"
        }
      ],
      "omitempty": true
    }
  }
}
