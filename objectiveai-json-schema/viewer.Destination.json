      "properties": {
        "plugin": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
