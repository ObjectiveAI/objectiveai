# Runtime artifacts of the shared test OBJECTIVEAI_DIR. Everything
# else in this tree is committed and fixed — no preparation step.
state/
bin/locks/
# Request/response trace the api's in-process mcp-proxy writes when
# OBJECTIVEAI_LOGS is on (<dir>/bin/api/logs/mcp-proxy.jsonl).
bin/api/
bin/pg-bin/
# objectiveai-db moves a partial pg-bin aside (rename-then-delete)
# before re-extracting; a leftover trash dir is inert.
bin/pg-bin.trash-*/
# Committed api test settings (fixed fixtures, not runtime artifacts):
# the global config layer `bin/config.json` (e.g. `mcp_timeout_ms`) and
# `.env`. Tests write their own PER-STATE config under `state/` (ignored
# above), never these. `.env` needs the `!` to override the root `.env*`.
!.env
