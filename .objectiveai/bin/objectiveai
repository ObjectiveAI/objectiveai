#!/usr/bin/env sh
# Dev shim: resolves its own filename to a workspace binary and execs
# the PRE-BUILT copy from the repo's `target/debug/` (two directories
# up). Args, env, stdio, and exit code pass straight through. No
# compilation happens here — build the binaries first with the repo
# root's `test-build.sh` (each suite's `test.sh` runs it
# automatically). Keeping cargo out of the shims means concurrent
# test processes can never trigger rebuilds or relink races against
# binaries that are currently running. (Windows resolves the sibling
# .exe copies of objectiveai-development-launcher instead; same
# dispatch.)
#
# Note: `objectiveai-viewer` additionally needs the frontend dist
# built once (`pnpm run build` in objectiveai-viewer/) before its
# crate can compile.
set -eu
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo=$(CDPATH= cd -- "$dir/../.." && pwd)
case "$(basename -- "$0")" in
  objectiveai)        bin=objectiveai-cli ;;
  objectiveai-api)    bin=objectiveai-api ;;
  objectiveai-viewer) bin=objectiveai-viewer ;;
  objectiveai-mcp)    bin=objectiveai-mcp ;;
  objectiveai-db)     bin=objectiveai-db ;;
  *) echo "objectiveai shim: unknown shim name: $(basename -- "$0")" >&2; exit 2 ;;
esac
exe="$repo/target/debug/$bin"
if [ ! -x "$exe" ] && [ ! -x "$exe.exe" ]; then
  echo "objectiveai shim: $exe is not built; run \`bash $repo/test-build.sh\` first" >&2
  exit 127
fi
exec "$exe" "$@"
