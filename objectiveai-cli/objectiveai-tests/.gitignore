# Built binaries are slotted at test runtime; never commit them.
*.exe
*.dll
*.dylib
*.so

# Runtime state the cli or fixtures might write into a CONFIG_BASE_DIR
# rooted at one of these subdirs. Keep the committed tree clean.
logs/
pipes/
plugin-pid
response-ids.txt
*.txt

# Allow only .gitkeep, .gitignore, JSON, and Markdown.
!.gitkeep
!.gitignore
!*.json
!*.md
