{
  "name": "@objectiveai/sdk",
  "version": "2.2.13",
  "description": "SDK for the ObjectiveAI API.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ObjectiveAI/objectiveai.git"
  },
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && node ./scripts/install-zod.cjs && node ./scripts/install-command-execute.cjs && node ./scripts/install-listener-execution.cjs && node ./scripts/install-wasm.cjs && tsup && shx rm -f dist/*.d.mts && shx rm -f dist/*.d.cts",
    "test": "node tests/test-cjs.cjs && node tests/test-esm.mjs && tsc --noEmit && vitest run",
    "start": "node dist/index.js"
  },
  "author": {
    "name": "ObjectiveAI",
    "email": "admin@objectiveai.dev",
    "url": "https://objectiveai.dev"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.2",
    "shx": "^0.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "llm",
    "ai",
    "api",
    "client",
    "sdk",
    "prompt",
    "prompt engineering",
    "machine learning",
    "ml",
    "objectiveai",
    "objective ai",
    "objective",
    "confidence",
    "confidence score",
    "rank",
    "score"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ]
}
