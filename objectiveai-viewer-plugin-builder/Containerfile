# REFERENCE EXAMPLE — a viewer-extension build, end to end.
#
# Nothing in ObjectiveAI reads this file. Plugins own their viewer
# build: a plugin's `objectiveai.json` declares
#
#   "viewer": { "containerfile": "viewer/Containerfile",
#               "output": "/dist",
#               "tabs": [ … ], "scripts": [ … ] }
#
# and the laboratory host builds THAT file with ITS OWN DIRECTORY as
# the build context — so this one, living at `viewer/Containerfile`,
# sees `viewer/` as its root and no COPY carries a `viewer/` prefix.
# The host then copies `output`'s CONTENTS out of the built image,
# removes the container and the image, and packs those contents as the
# installed `viewer/` directory. Copy this into your plugin repo and
# change what you like — Tailwind, PostCSS, Sass, a different base
# image, a different bundler.
#
# The image is never STARTED, only copied out of, so the build must
# happen in `RUN` steps and `output` must name a directory those steps
# already populated (here, /dist).
#
# THE ONE RULE: leave `react`, `react-dom`, `react/jsx-runtime` and
# `react-dom/client` EXTERNAL in TAB bundles. The host viewer serves
# them through an import map so every plugin shares its single React
# instance; a bundle carrying its own copy dies on the first hook.
# Anything the host does NOT ship bundles in normally.
#
# Reproduce a build exactly as the host does it:
#
#   podman build -t my-viewer-build -f viewer/Containerfile viewer
#   podman create --name x my-viewer-build && podman cp x:/dist/. out/
#   podman rm x && podman rmi my-viewer-build

FROM docker.io/library/node:22-alpine

# The bundler lives in the IMAGE, not in the plugin's package.json —
# nothing about esbuild belongs in the dependency tree the components
# are typechecked against.
RUN corepack enable && npm install --global esbuild@0.25.10

WORKDIR /build
# Dependencies first, so editing a component doesn't re-run install.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --ignore-workspace --no-frozen-lockfile
COPY . ./

# TABS: `--format=esm` with react EXTERNAL, because the host renders
# these components and owns the React instance. `--outbase=.` keeps
# each entry's relative path, so `home.tsx` lands at `/dist/home.js` —
# which is what the manifest's tab `module` paths name. A tab's
# stylesheets ship as ordinary `.css` files beside it and are listed
# in the manifest's `styles`; the host injects and awaits them.
RUN esbuild home.tsx greet.tsx \
    --bundle \
    --format=esm \
    --platform=browser \
    --outdir=/dist \
    --outbase=. \
    --jsx=automatic \
    --external:react \
    --external:react-dom \
    --external:react/jsx-runtime \
    --external:react-dom/client

# SCRIPTS: the OPPOSITE build. A script is injected into a page the
# plugin does not own, where no import map exists and the injector
# evaluates a CLASSIC script — so `--format=iife`, and NOTHING is
# external, react included. CSS must be inlined as a string
# (`--loader:.css=text`) and applied through CSSOM into a shadow root:
# a stylesheet URL is unreachable from a foreign page, and a strict
# site's CSP would block it anyway.
RUN esbuild overlay.ts \
    --bundle \
    --format=iife \
    --platform=browser \
    --outfile=/dist/overlay.js \
    --jsx=automatic \
    --loader:.css=text
