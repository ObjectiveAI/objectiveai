{
  "name": "@diverge/sdk",
  "version": "2.3.0",
  "description": "The Diverge SDK for TypeScript: the daemon protocol as zod schemas, spoken over the wire or through a Tauri proxy.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ObjectiveAI/objectiveai.git",
    "directory": "diverge-sdk-js"
  },
  "homepage": "https://diverge.network",
  "author": {
    "name": "Diverge",
    "email": "admin@diverge.network",
    "url": "https://diverge.network"
  },
  "license": "MIT",
  "keywords": [
    "diverge",
    "sdk",
    "daemon",
    "agents",
    "websocket",
    "zod"
  ]
}
