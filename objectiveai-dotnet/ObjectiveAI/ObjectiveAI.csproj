<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>ObjectiveAI</PackageId>
    <Version>2.0.8</Version>
    <Authors>ObjectiveAI</Authors>
    <Description>SDK for the ObjectiveAI API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ObjectiveAI/objectiveai</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://objectiveai.dev</PackageProjectUrl>
    <PackageTags>llm;ai;swarm;scoring;ranking</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Include native CFFI libraries from runtimes/ (built by build.sh) -->
  <!-- Pack into NuGet under runtimes/ for package consumers -->
  <ItemGroup>
    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes" />
  </ItemGroup>


  <!-- Include README in the NuGet package -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" Condition="Exists('..\README.md')" />
  </ItemGroup>

</Project>
