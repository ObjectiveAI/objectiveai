{
  "type": "alpha.vector.branch.function",
  "description": "Ranks items with an optional quality-focused sub-ranker.",
  "input_schema": {
    "context": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "include_quality": {
          "type": "boolean"
        }
      },
      "required": [
        "query"
      ]
    },
    "items": {
      "type": "string"
    }
  },
  "tasks": [
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "item-ranker",
      "input": {
        "items": {
          "$starlark": "input['items']"
        }
      }
    },
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "contextual-ranker",
      "skip": {
        "$starlark": "not input['context'].get('include_quality', False)"
      },
      "input": {
        "context": {
          "$starlark": "input['context']"
        },
        "items": {
          "$starlark": "input['items']"
        }
      }
    }
  ]
}
