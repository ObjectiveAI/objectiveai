{
  "type": "alpha.vector.branch.function",
  "description": "Combines classification and ranking with optional deep analysis of email importance and contextual relevance.",
  "input_schema": {
    "context": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "deep": {
          "type": "boolean"
        }
      },
      "required": [
        "query"
      ]
    },
    "items": {
      "type": "string"
    }
  },
  "tasks": [
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "binary-classifier",
      "input": {
        "$starlark": "{'text': input['context']['query']}"
      }
    },
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "item-ranker",
      "input": {
        "items": {
          "$starlark": "input['items']"
        }
      }
    },
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "email-importance",
      "skip": {
        "$starlark": "not input['context'].get('deep', False)"
      },
      "input": {
        "$starlark": "{'subject': input['context']['query'], 'body': input['context']['query']}"
      }
    },
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "contextual-ranker",
      "skip": {
        "$starlark": "not input['context'].get('deep', False)"
      },
      "input": {
        "context": {
          "$starlark": "input['context']"
        },
        "items": {
          "$starlark": "input['items']"
        }
      }
    }
  ]
}
