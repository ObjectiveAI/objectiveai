{
  "type": "alpha.scalar.branch.function",
  "description": "Classifies text with an optional importance analysis.",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "include_sentiment": {
        "type": "boolean"
      }
    },
    "required": [
      "text"
    ]
  },
  "tasks": [
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "binary-classifier",
      "input": {
        "$starlark": "input"
      }
    },
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "email-importance",
      "skip": {
        "$starlark": "not input.get('include_sentiment', False)"
      },
      "input": {
        "$starlark": "{'subject': input['text'], 'body': input['text']}"
      }
    }
  ]
}
