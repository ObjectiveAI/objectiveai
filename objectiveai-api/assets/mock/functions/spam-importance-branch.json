{
  "type": "alpha.scalar.branch.function",
  "description": "Evaluates text for both spam likelihood and email importance.",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "subject": {
        "type": "string"
      }
    },
    "required": [
      "text",
      "subject"
    ]
  },
  "tasks": [
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "binary-classifier",
      "input": {
        "$starlark": "{'text': input['text']}"
      }
    },
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "email-importance",
      "input": {
        "$starlark": "{'subject': input['subject'], 'body': input['text']}"
      }
    }
  ]
}
