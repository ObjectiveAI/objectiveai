{
  "type": "alpha.scalar.branch.function",
  "description": "Evaluates text using binary classification, five-star rating, and importance scoring.",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text"
    ]
  },
  "tasks": [
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "binary-classifier",
      "input": {
        "$starlark": "input"
      }
    },
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "five-star-rating",
      "input": {
        "$starlark": "input"
      }
    },
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "email-importance",
      "input": {
        "$starlark": "{'subject': input['text'], 'body': input['text']}"
      }
    }
  ]
}
