{
  "type": "scalar.function",
  "description": "Scalar classifier whose task expression references an input key that does not exist.",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text"
    ]
  },
  "tasks": [
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': input['missing_key']}]}]"
      },
      "responses": [
        [
          {
            "type": "text",
            "text": "Yes"
          }
        ],
        [
          {
            "type": "text",
            "text": "No"
          }
        ]
      ],
      "output": {
        "$special": "task_output_weighted_sum"
      }
    }
  ]
}
