{
  "type": "alpha.vector.leaf.function",
  "description": "Ranks items by relevance and accuracy, with optional strict fact-checking and source reliability criteria.",
  "input_schema": {
    "context": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "strict": {
          "type": "boolean"
        }
      },
      "required": [
        "query"
      ]
    },
    "items": {
      "type": "string"
    }
  },
  "tasks": [
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': 'Query: ' + input['context']['query'] + '. Rank by relevance.'}]}]"
      },
      "responses": {
        "$starlark": "[[{'type': 'text', 'text': item}] for item in input['items']]"
      }
    },
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': 'Query: ' + input['context']['query'] + '. Rank by accuracy.'}]}]"
      },
      "responses": {
        "$starlark": "[[{'type': 'text', 'text': item}] for item in input['items']]"
      }
    },
    {
      "type": "vector.completion",
      "skip": {
        "$starlark": "not input['context'].get('strict', False)"
      },
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': 'Query: ' + input['context']['query'] + '. Rank by factual correctness.'}]}]"
      },
      "responses": {
        "$starlark": "[[{'type': 'text', 'text': item}] for item in input['items']]"
      }
    },
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': 'Query: ' + input['context']['query'] + '. Rank by helpfulness.'}]}]"
      },
      "responses": {
        "$starlark": "[[{'type': 'text', 'text': item}] for item in input['items']]"
      }
    },
    {
      "type": "vector.completion",
      "skip": {
        "$starlark": "not input['context'].get('strict', False)"
      },
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': 'Query: ' + input['context']['query'] + '. Rank by source reliability.'}]}]"
      },
      "responses": {
        "$starlark": "[[{'type': 'text', 'text': item}] for item in input['items']]"
      }
    }
  ]
}
