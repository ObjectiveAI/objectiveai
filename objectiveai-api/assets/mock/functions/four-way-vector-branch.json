{
  "type": "alpha.vector.branch.function",
  "description": "Ranks items using two classifiers and two rankers for comprehensive evaluation.",
  "input_schema": {
    "context": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "items": {
      "type": "string"
    }
  },
  "tasks": [
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "binary-classifier",
      "input": {
        "$starlark": "{'text': input['context']['text']}"
      }
    },
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "five-star-rating",
      "input": {
        "$starlark": "{'text': input['context']['text']}"
      }
    },
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "item-ranker",
      "input": {
        "items": {
          "$starlark": "input['items']"
        }
      }
    },
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "five-criteria-ranker",
      "input": {
        "items": {
          "$starlark": "input['items']"
        }
      }
    }
  ]
}
