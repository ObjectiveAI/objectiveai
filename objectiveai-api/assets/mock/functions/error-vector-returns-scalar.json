{
  "type": "vector.function",
  "description": "Vector ranker whose output expression returns a single scalar instead of a vector.",
  "input_schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "items"
    ]
  },
  "tasks": [
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': 'rank: ' + ', '.join(input['items'])}]}]"
      },
      "responses": {
        "$starlark": "[[{'type': 'text', 'text': item}] for item in input['items']]"
      },
      "output": {
        "$starlark": "output[0]"
      }
    }
  ],
  "output_length": {
    "$starlark": "len(input['items'])"
  },
  "input_split": {
    "$special": "input_items_optional_context_split"
  },
  "input_merge": {
    "$special": "input_items_optional_context_merge"
  }
}
