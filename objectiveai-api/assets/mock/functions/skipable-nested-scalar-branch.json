{
  "type": "alpha.scalar.branch.function",
  "description": "Three nested scalar branches for thorough text evaluation, with the middle branch conditional on a thoroughness flag.",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "subject": {
        "type": "string"
      },
      "thorough": {
        "type": "boolean"
      }
    },
    "required": [
      "text",
      "subject"
    ]
  },
  "tasks": [
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "spam-importance-branch",
      "input": {
        "$starlark": "{'text': input['text'], 'subject': input['subject']}"
      }
    },
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "classifier-with-optional-sentiment",
      "skip": {
        "$starlark": "not input.get('thorough', False)"
      },
      "input": {
        "$starlark": "{'text': input['text'], 'include_sentiment': True}"
      }
    },
    {
      "type": "alpha.scalar.function",
      "remote": "mock",
      "name": "triple-classifier-branch",
      "input": {
        "$starlark": "{'text': input['subject']}"
      }
    }
  ]
}
