{
  "type": "alpha.scalar.leaf.function",
  "description": "Classifies text as yes or no.",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Text to classify"
      }
    },
    "required": [
      "text"
    ]
  },
  "tasks": [
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': input['text']}]}]"
      },
      "responses": [
        [
          {
            "type": "text",
            "text": "Yes"
          }
        ],
        [
          {
            "type": "text",
            "text": "No"
          }
        ]
      ]
    }
  ]
}
