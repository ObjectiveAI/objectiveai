{
  "type": "alpha.vector.branch.function",
  "description": "Three nested vector branches for comprehensive context-aware item ranking.",
  "input_schema": {
    "context": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "items": {
      "type": "string"
    }
  },
  "tasks": [
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "dual-ranker-branch",
      "input": {
        "items": {
          "$starlark": "input['items']"
        }
      }
    },
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "mixed-scalar-vector-branch",
      "input": {
        "context": {
          "$starlark": "{'query': input['context']['text']}"
        },
        "items": {
          "$starlark": "input['items']"
        }
      }
    },
    {
      "type": "alpha.vector.function",
      "remote": "mock",
      "name": "four-way-vector-branch",
      "input": {
        "context": {
          "$starlark": "{'text': input['context']['text']}"
        },
        "items": {
          "$starlark": "input['items']"
        }
      }
    }
  ]
}
