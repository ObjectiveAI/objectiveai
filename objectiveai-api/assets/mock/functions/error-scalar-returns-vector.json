{
  "type": "scalar.function",
  "description": "Scalar classifier whose output expression returns a vector instead of a scalar.",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text"
    ]
  },
  "tasks": [
    {
      "type": "vector.completion",
      "messages": {
        "$starlark": "[{'role': 'user', 'content': [{'type': 'text', 'text': input['text']}]}]"
      },
      "responses": [
        [
          {
            "type": "text",
            "text": "Yes"
          }
        ],
        [
          {
            "type": "text",
            "text": "No"
          }
        ]
      ],
      "output": {
        "$starlark": "[0.5, 0.5]"
      }
    }
  ]
}
